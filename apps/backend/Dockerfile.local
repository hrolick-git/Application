FROM node:20-bullseye-slim

WORKDIR /app

# Встановлюємо openssl для Prisma
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Копіюємо тільки файли залежностей спочатку (для кешування)
COPY package*.json ./
# Копіюємо папку prisma
COPY prisma ./prisma/

# Встановлюємо ВСІ залежності (включаючи dev для роботи nodemon/ts-node)
RUN npm install --legacy-peer-deps

# Генеруємо клієнт Prisma
RUN npx prisma generate --schema ./prisma/schema.prisma

# Копіюємо решту коду
COPY . .

EXPOSE 4000

# Для локальної розробки краще використовувати npm run dev, 
# щоб працював hot-reload (якщо він у тебе налаштований)
CMD ["sh", "-c", "npx prisma migrate dev && npm run dev"]